# Rename this file to .env before running the backend

# Local MongoDB (default if you installed MongoDB Community locally)
MONGO_URI=mongodb://127.0.0.1:27017/food-rescue

# Or use a free MongoDB Atlas cluster instead, e.g.:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/food-rescue

# Any long random string works
JWT_SECRET=change_this_to_a_long_random_secret

PORT=5000

# Default matching radius in kilometers (matches the 20-30 km in the report)
MATCH_RADIUS_KM=25
